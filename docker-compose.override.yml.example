version: "3.8"

# WebORCA のログをホストへ永続化する override 例。
# 1) このファイルを docker-compose.override.yml としてコピー
# 2) `mkdir -p orca-logs` でホスト側ディレクトリを準備（Runbook §4.5 ログ永続化手順参照）
# 3) `docker compose up -d --force-recreate orca` を実行してボリュームを反映

services:
  orca:
    environment:
      LOGDIR: /opt/jma/weborca/log
    volumes:
      - type: bind
        source: ./orca-logs
        target: /opt/jma/weborca/log
